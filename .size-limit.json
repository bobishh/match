[
  {
    "name": "initial JavaScript",
    "path": "dist/assets/index-*.js",
    "limit": "235 kB"
  },
  {
    "name": "application CSS",
    "path": "dist/assets/index-*.css",
    "limit": "10.5 kB"
  },
  {
    "name": "Markdown renderer (loaded on demand)",
    "path": "dist/assets/MarkdownContent-*.js",
    "limit": "40 kB"
  },
  {
    "name": "Markdown styles (loaded on demand)",
    "path": "dist/assets/MarkdownContent-*.css",
    "limit": "1 kB"
  },
  {
    "name": "Automerge WebAssembly",
    "path": "dist/assets/automerge-*.wasm",
    "limit": "1.1 MB"
  },
  {
    "name": "transport WebAssembly (loaded on network demand)",
    "path": "dist/assets/meta_mesh_bg-*.wasm",
    "limit": "2.3 MB"
  },
  {
    "name": "policy WebAssembly (required for local access)",
    "path": "dist/assets/meta_mesh_policy_bg-*.wasm",
    "limit": "1.2 MB"
  }
]
