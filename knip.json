{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts",
        "e2e/**/*.spec.ts",
        "playwright.config.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "scripts/**/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        "e2e/**/*.ts",
        "scripts/**/*.mjs",
        "*.config.ts"
      ],
      "ignoreUnresolved": ["^/src/", "^/vendor/meta-mesh/", "^/@id/"],
      "paths": {
        "/e2e/*": ["./e2e/*"]
      },
      "ignoreIssues": {
        "*.config.ts": ["exports"]
      }
    }
  },
  "ignoreIssues": {
    "*.config.ts": ["exports"]
  },
  "ignoreWorkspaces": ["vendor/meta-mesh/packages/**"],
  "includeEntryExports": true,
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ]
}
